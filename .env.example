
# The following depend on your selected configuration
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
GOOGLE_API_KEY=

# LLM provider: gemini | bedrock (default gemini)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# AWS Bedrock (used when LLM_PROVIDER=bedrock)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Vector Store Selection
VECTOR_DB=qdrant

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COL=extract-rag.default

# LanceDB (used when VECTOR_DB=lancedb)
LANCEDB_URI=./.rag_cache/db/lancedb

DATA_DIR=./docs
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
LABELS="Macroeconomics,Government-Work,Currencies,Energy,Commodities,Agriculture,Livestock,Corporate-Finance"
