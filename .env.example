
# The following depend on your selected configuration
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
GOOGLE_API_KEY=

# Vector Store Selection
VECTOR_DB=qdrant

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COL=extract-rag.default

# LanceDB (used when VECTOR_DB=lancedb)
LANCEDB_URI=./.rag_cache/db/lancedb

DATA_DIR=./docs
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
LABELS="Macroeconomics,Government-Work,Currencies,Energy,Commodities,Agriculture,Livestock,Corporate-Finance"
